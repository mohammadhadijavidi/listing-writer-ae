# Provider: mock | openai | openrouter | groq | ollama | lmstudio | openai-compatible | anthropic
# mock = offline bilingual template writer (no LLM, no key). Its output is labelled as such.
LISTING_PROVIDER=mock
# LISTING_MODEL=gpt-4o-mini

# OpenAI-compatible endpoints (OpenAI, OpenRouter, Groq, Ollama, LM Studio, vLLM, ...)
# LISTING_BASE_URL=https://openrouter.ai/api/v1
# LISTING_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Web server
# LISTING_HOST=127.0.0.1
# LISTING_PORT=8000
